# Copy to .env and adjust. Every variable is optional; defaults use SQLite.
ORBIT_DATABASE_URL=postgresql+psycopg://orbit:orbit@localhost:5432/orbit
ORBIT_JWT_SECRET=replace-with-a-long-random-string
ORBIT_JWT_TTL_SECONDS=2592000
ORBIT_MAX_BATCH_SIZE=5000
ORBIT_PLACE_SEARCH_RADIUS_M=50
ORBIT_PLACE_MIN_CONFIDENCE=0.35
ORBIT_PLACE_TIMEZONE=America/Chicago
